[user]
    name = "Keisuke Hirota"
    email = "14054951+k-tahiro@users.noreply.github.com"
{{- if eq .chezmoi.os "darwin" }}
[credential "https://github.com"]
    helper =
    helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !/opt/homebrew/bin/gh auth git-credential
{{- else if eq .chezmoi.os "linux" }}
[credential "https://github.com"]
    helper =
    helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
{{- end }}
[alias]
    prune-branches = "!f() { git fetch -p; branches=$(git branch -vv | awk \"/: gone]/{print \\$1}\"); if [ -n \"$branches\" ]; then echo \"$branches\" | xargs git branch -D; echo \"不要なブランチを削除しました。\"; else echo \"削除する不要なブランチはありません。\"; fi; }; f"
