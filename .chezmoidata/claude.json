{
  "claude": {
    "settings": {
      "env": {
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
      },
      "permissions": {
        "defaultMode": "plan",
        "allow": [
          "Bash(cat *)",
          "Bash(echo *)",
          "Bash(find *)",
          "Bash(gcloud * list *)",
          "Bash(gcloud * * list *)",
          "Bash(gcloud config get *)",
          "Bash(gcloud logging read *)",
          "Bash(gh * list *)",
          "Bash(gh issue view *)",
          "Bash(git *)",
          "Bash(grep *)",
          "Bash(gsutil ls *)",
          "Bash(ls *)",
          "Bash(mkdir *)",
          "Bash(rtk find *)",
          "Bash(rtk gh * list *)",
          "Bash(rtk gh issue view *)",
          "Bash(rtk git *)",
          "Bash(rtk grep *)",
          "Bash(rtk ls *)",
          "Bash(uv *)",
          "Bash(* --help)",
          "Bash(* --version)",
          "Read"
        ],
        "ask": [
          "Bash(git push *)",
          "Bash(gh api *)",
          "Bash(gh issue comment *)",
          "Bash(gh issue create *)",
          "Bash(gh issue edit *)",
          "Bash(gh sub-issue add *)",
          "Bash(gh sub-issue create *)",
          "Bash(gh sub-issue remove *)",
          "Bash(rtk gh api *)",
          "Bash(rtk gh issue comment *)",
          "Bash(rtk gh issue create *)",
          "Bash(rtk gh issue edit *)",
          "Bash(rtk gh sub-issue add *)",
          "Bash(rtk gh sub-issue create *)",
          "Bash(rtk gh sub-issue remove *)",
          "Bash(rtk git push *)",
          "Bash(rm -rf)",
          "Bash(uv run *)"
        ],
        "deny": [
          "Bash(gcloud auth *)",
          "Bash(rm -rf /)",
          "Bash(sudo *)",
          "Bash(uv auth *)",
          "Bash(uv publish *)",
          "Read(~/.config/zsh/.zprofile.local)",
          "Read(~/.config/zsh/.zshrc.local)",
          "Read(./.env)",
          "Read(./.envrc)"
        ]
      }
    }
  }
}
