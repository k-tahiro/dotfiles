{{- /* chezmoi:modify-template */ -}}
{{- $config := fromJson (default "{}" .chezmoi.stdin) -}}
{{- $sourceServers := (.mcp.shared | default dict) -}}
{{- if .isWork -}}
{{-   $sourceServers = mergeOverwrite $sourceServers (.mcp.work | default dict) -}}
{{- else -}}
{{-   $sourceServers = mergeOverwrite $sourceServers (.mcp.private | default dict) -}}
{{- end -}}
{{- with (get $sourceServers "serena") -}}
  {{- $args := concat (.args | default list) (list "claude-code") -}}
  {{- $sourceServers = mergeOverwrite $sourceServers (dict "serena" (mergeOverwrite . (dict "args" $args))) -}}
{{- end -}}
{{- $servers := dict -}}
{{- range $name, $server := $sourceServers -}}
  {{- $serverConfig := omit $server "bearer_token_env_var" -}}
  {{- if and (hasKey $serverConfig "url") (not (hasKey $serverConfig "type")) -}}
    {{- $serverConfig = mergeOverwrite $serverConfig (dict "type" "http") -}}
  {{- end -}}
  {{- if hasKey $server "bearer_token_env_var" -}}
    {{- $headerValue := printf "Bearer ${%s}" $server.bearer_token_env_var -}}
    {{- $headers := mergeOverwrite (dict) (get $serverConfig "headers" | default dict) (dict "Authorization" $headerValue) -}}
    {{- $serverConfig = mergeOverwrite $serverConfig (dict "headers" $headers) -}}
  {{- end -}}
  {{- $servers = mergeOverwrite $servers (dict $name $serverConfig) -}}
{{- end -}}
{{- $config = mergeOverwrite $config (dict "mcpServers" $servers) -}}
{{- $config | toPrettyJson -}}
