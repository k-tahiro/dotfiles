# ==========================================
# .zshrc
# ==========================================

# 0. Zellij
# ------------------------------------------
if [[ -z "$ZELLIJ" ]] && type fzf >/dev/null 2>&1; then
  local zellij_sessions=$(zellij list-sessions -n 2>/dev/null | awk '{print $1}')
  
  # メニューの選択肢
  local choices="✨ [New] 自動で名前をつけて新規作成\n✏️ [New] 名前を指定して新規作成"
  if [[ -n "$zellij_sessions" ]]; then
    choices="$choices\n$zellij_sessions"
  fi
  
  # fzfでメニュー表示
  local selected=$(echo -e "$choices" | fzf --prompt="Zellij Session ❯ " --height=40% --reverse --border --inline-info)
  
  if [[ -n "$selected" ]]; then
    local target_session=""
    local zellij_args=()
    
    if [[ "$selected" == "✨ [New] 自動で名前をつけて新規作成" ]]; then
      # 終了・デタッチ判定のためにセッション名を追跡する必要があるため、
      # Zellijのおまかせ命名ではなく、zsh側で日時ベースのユニークな名前を生成します
      target_session="session-$(date +%Y%m%d-%H%M%S)"
      zellij_args=(attach -c "$target_session")
      
    elif [[ "$selected" == "✏️ [New] 名前を指定して新規作成" ]]; then
      echo -n "新しいセッション名を入力してください: "
      read target_session </dev/tty
      if [[ -n "$target_session" ]]; then
        zellij_args=(attach -c "$target_session")
      else
        # 未入力時は日時ベースにする
        target_session="session-$(date +%Y%m%d-%H%M%S)"
        zellij_args=(attach -c "$target_session")
      fi
      
    else
      # 既存セッションを選択した場合
      target_session="$selected"
      zellij_args=(attach "$target_session")
    fi
    
    # exec は使わず、通常のコマンドとしてZellijを起動（親シェルの処理はここで一時停止）
    zellij "${zellij_args[@]}"
    local zellij_exit_code=$?
    
    # Zellijがクラッシュ等の異常終了をした場合は、安全のため判定をスキップしてシェルを残す
    if [[ $zellij_exit_code -eq 0 ]]; then
      # Zellijから抜けた後、ターゲットにしていたセッションがまだ存在するか確認
      local session_exists=$(zellij list-sessions -n 2>/dev/null | awk -v t="$target_session" '$1 == t {print $1}')
      
      if [[ -z "$session_exists" ]]; then
        # セッションが存在しない = exit（全ペインを閉じた）で抜けた
        # WezTermのタブごと閉じるために親シェルも終了させる
        exit
      fi
      # セッションが存在する = detach で抜けた
      # このまま下の処理（.zshrcの続き）へ進み、元のシェルのプロンプトを出す
    fi
  fi
fi

# 1. Zshの基本設定
# ------------------------------------------
setopt auto_cd           # ディレクトリ名だけで移動
setopt hist_ignore_dups  # 重複した履歴を保存しない
setopt share_history     # 複数端末で履歴を共有

# 履歴ファイルも ZDOTDIR の中に隠す
HISTFILE="$ZDOTDIR/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

# 2. ツールの初期化 (Initialization)
# ------------------------------------------
eval "$(mise activate zsh)"
eval "$(zoxide init zsh --cmd cd)"
eval "$(direnv hook zsh)"

# --- fzf のベース設定 (fd 連携とモダンなUI) ---
source <(fzf --zsh)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'

# 画面下40%を使い、モダンなカラーリングと枠線をつける
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --inline-info --color=hl:#ffb86c,hl+:#ff79c6,pointer:#bd93f9,info:#ffb86c,prompt:#50fa7b"

# --- fzf のプレビュー強化 (bat / eza 連携) ---
# Ctrl+T (ファイル検索): bat でシンタックスハイライト
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:500 {}'"
# Alt+C (ディレクトリ移動): eza でツリー表示
export FZF_ALT_C_OPTS="--preview 'eza -T -L 2 --icons {}'"
# Ctrl+R (履歴検索): 長いコマンドを折り返し表示
export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window up:3:hidden:wrap --bind '?:toggle-preview'"

# 3. エイリアス (Aliases)
# ------------------------------------------
# --- モダンツールへの置き換え ---
alias ls='eza --icons --group-directories-first'
alias ll='eza -l --icons --group-directories-first --time-style=long-iso'
alias la='eza -la --icons --group-directories-first --time-style=long-iso'
alias tree='eza -T --icons'
alias cat='bat --theme=TwoDark'
alias grep='rg'
alias rgi='rg -i'
alias rgh='rg --hidden'
alias vi='nvim'
alias vim='nvim'

# --- ツールのショートカット ---
alias lg='lazygit'
alias zj='zellij'
alias za='zellij attach'
alias zls='zellij list-sessions'
alias btm='bottom'
alias cm='chezmoi'
alias cma='chezmoi apply'
alias mr='mise run'
alias mx='mise exec --'

# --- 安全・便利系 ---
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'
alias mkdir='mkdir -p'
alias ..='cd ..'
alias ...='cd ../..'

# --- Git系 ---
alias g='git'
alias gst='git status'
alias gd='git diff'
alias gco='git checkout'
alias gcm='git commit -m'
alias gpb='git prune-branches'

# --- その他 ---
alias relogin='exec $SHELL -l'

# 4. グローバルエイリアス (Global Aliases)
# ------------------------------------------
# パイプ (|) で繋ぐ処理を大文字1文字で省略できます
alias -g B='| bat'                 # 使い方例: curl https://example.com B
alias -g J='| jq'                  # 使い方例: cat data.json J
alias -g Y='| yq'                  # 使い方例: cat config.yaml Y
alias -g F='| fzf'                 # 使い方例: ps aux F
alias -g H='--help 2>&1 | bat --language=help --style=plain' # 使い方例: ls H


# 5. 関数とキーバインド (Functions & Keybinds)
# ------------------------------------------
# 【1】ghq + fzf: Alt+G でリポジトリを検索して移動
function ghq-fzf() {
  local repo=$(ghq list | fzf --preview "eza -la --icons $(ghq root)/{} | head -n 20")
  if [ -n "$repo" ]; then
    BUFFER="cd $(ghq root)/${repo}"
    zle accept-line
  fi
  zle -R -c
}
zle -N ghq-fzf
bindkey '^[g' ghq-fzf

# 【2】fgrep: rg で全ファイルの中身を検索 → bat でプレビュー → nvim で該当行を開く
function fgrep() {
  local file_line=$(
    rg --line-number --no-heading --color=always --smart-case "" |
    fzf --ansi \
        --color "hl:-1:underline,hl+:-1:underline:reverse" \
        --delimiter : \
        --preview 'bat --color=always --style=numbers {1} --highlight-line {2}' \
        --preview-window 'up,60%,border-bottom,+{2}+3/3,~3'
  )
  
  if [ -n "$file_line" ]; then
    local file=$(echo "$file_line" | awk -F: '{print $1}')
    local line=$(echo "$file_line" | awk -F: '{print $2}')
    nvim "$file" +"$line"
  fi
}

# 【3】gcb: Gitブランチをプレビュー付きで高速切り替え
function gcb() {
  local branch=$(git branch -a --format='%(refname:short)' | fzf --height 30% --prompt="Branch> " --preview "git log -n 10 --color=always {}")
  if [ -n "$branch" ]; then
    git checkout "$branch"
  fi
}

{{- if eq .chezmoi.os "darwin" }}
# 【4】notify: macにおける通知作成
function notify() {
  local message="$1"
  osascript -e "display notification \"$message\" with title \"Shell\""
}
{{- end }}

# 6. プラグイン (Plugins)
# ------------------------------------------
# Homebrewのインストール先パスを取得
HOMEBREW_PREFIX=$(brew --prefix)

# ① 過去の履歴からコマンドを薄いグレーでサジェスト（右矢印 '→' または 'Ctrl+E' で確定）
if [ -f "${HOMEBREW_PREFIX}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
  source "${HOMEBREW_PREFIX}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# ② コマンドの構文ハイライト（※必ず設定の最後に読み込む！）
if [ -f "${HOMEBREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
  source "${HOMEBREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# 7. Local
# ------------------------------------------
if [ -f "$ZDOTDIR/.zshrc.local" ]; then
  source "$ZDOTDIR/.zshrc.local"
fi

# 8. プロンプト (Prompt) - ※必ず最後に読み込む
# ------------------------------------------
eval "$(starship init zsh)"
