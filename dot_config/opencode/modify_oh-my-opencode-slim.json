{{- /* chezmoi:modify-template */ -}}
{{- $multiplexer := dict "type" "auto" "layout" "main-vertical" "main_pane_size" 60 -}}
{{- $presets := dict -}}
{{- 
  $presets = mergeOverwrite $presets (dict
    "opencode-zen-free" (dict
      "orchestrator" (dict "model" "opencode/x-preview-f-free" "variant" "high" "temperature" 0.4 "skills" (list "*") "mcps" (list "*" "!context7"))
      "oracle" (dict "model" "opencode/big-pickle" "variant" "max" "temperature" 0.4 "skills" (list "simplify") "mcps" (list))
      "explorer" (dict "model" "opencode/nemotron-3.5-lightining-free" "temperature" 0.2 "skills" (list) "mcps" (list))
      "librarian" (dict "model" "opencode/nemotron-3.5-lightining-free" "temperature" 0.2 "skills" (list) "mcps" (list "context7" "gh_grep"))
      "designer" (dict "model" "opencode/mimo-v2.5-free" "variant" "medium" "temperature" 0.3 "skills" (list) "mcps" (list))
      "fixer" (dict "model" "opencode/hy3-free" "variant" "high" "temperature" 0.2 "skills" (list) "mcps" (list))
      "observer" (dict "model" "opencode/mimo-v2.5-free" "variant" "low" "temperature" 0.2 "skills" (list) "mcps" (list))
    )
  )
-}}

{{- $config := fromJson (default "{}" .chezmoi.stdin) -}}
{{- $config = mergeOverwrite $config (dict "multiplexer" $multiplexer) -}}
{{- $config = mergeOverwrite $config (dict "presets" $presets) -}}
{{- $config = mergeOverwrite $config (dict "preset" "opencode-zen-free") -}}
{{- $config | toPrettyJson -}}
