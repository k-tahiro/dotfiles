{{- /* chezmoi:modify-template */ -}}
{{- $multiplexer := dict "type" "auto" "layout" "main-vertical" "main_pane_size" 60 -}}
{{- $presets := dict -}}
{{- range $presetName, $agents := .ohMyOpencodeSlim.presets -}}

  {{- $preset := dict -}}

  {{- range $agentName, $override := $agents -}}
    {{- $capabilities := default (dict) (index $.ohMyOpencodeSlim.agentCapabilities $agentName) -}}
    {{- $agent := mergeOverwrite (deepCopy $capabilities) $override -}}
    {{- $_ := set $preset $agentName $agent -}}
  {{- end -}}

  {{- $_ := set $presets $presetName $preset  -}}
{{- end -}}

{{- $config := fromJson (default "{}" .chezmoi.stdin) -}}
{{- $config = mergeOverwrite $config (dict "multiplexer" $multiplexer) -}}
{{- $config = mergeOverwrite $config (dict "presets" $presets) -}}
{{- $config = mergeOverwrite $config (dict "preset" $.ohMyOpencodeSlim.preset) -}}
{{- $config | toPrettyJson -}}
