-- WezTerm Configuration
local wezterm = require 'wezterm'
local act = wezterm.action
local config = wezterm.config_builder()

-- OS Specific Settings
{{- if eq .chezmoi.os "windows" }}
local distro = "Ubuntu"
config.default_domain = 'WSL:' .. distro
{{- end }}

-- General Behavior
config.automatically_reload_config = true
config.window_close_confirmation = 'AlwaysPrompt'
config.use_ime = true
config.ime_preedit_rendering = 'System'
config.default_cursor_style = 'BlinkingUnderline'

-- Appearance & Layout
config.color_scheme = 'Dracula+'
config.char_select_bg_color = "#282A36"
config.char_select_fg_color = "#F8F8F2"
config.window_background_opacity = 0.85
config.hide_tab_bar_if_only_one_tab = true
config.enable_scroll_bar = true
wezterm.on("format-tab-title", function(tab)
  return tab.active_pane.title
end)

-- Font Settings
config.font = wezterm.font_with_fallback {
    { family = 'Moralerspace Neon', weight = "Bold" },
    { family = 'HackGen Console NF', weight = "Bold" }
}
config.font_size = {{ if eq .chezmoi.os "windows" -}}14.0{{ else }}16.0{{ end }}

-- Keybind
config.disable_default_key_bindings = true
config.keys = {
  -- クリップボード（macOS: Cmd、Linux/Win: Ctrl+Shift）
  { key = 'c', mods = 'SUPER',      action = act.CopyTo 'Clipboard' },
  { key = 'v', mods = 'SUPER',      action = act.PasteFrom 'Clipboard' },
  { key = 'c', mods = 'CTRL|SHIFT', action = act.CopyTo 'Clipboard' },
  { key = 'v', mods = 'CTRL|SHIFT', action = act.PasteFrom 'Clipboard' },

  -- フォントサイズ
  { key = '=', mods = 'SUPER', action = act.IncreaseFontSize },
  { key = '=', mods = 'CTRL',  action = act.IncreaseFontSize },
  { key = '-', mods = 'SUPER', action = act.DecreaseFontSize },
  { key = '-', mods = 'CTRL',  action = act.DecreaseFontSize },
  { key = '0', mods = 'SUPER', action = act.ResetFontSize },
  { key = '0', mods = 'CTRL',  action = act.ResetFontSize },

  -- ウィンドウ操作
  { key = 'n',     mods = 'SUPER',      action = act.SpawnWindow },
  { key = 'n',     mods = 'CTRL|SHIFT', action = act.SpawnWindow },
  { key = 'Enter', mods = 'ALT',        action = act.ToggleFullScreen },

  -- WezTermタブ切り替え（= Zellijセッション切り替え）
  { key = '1', mods = 'CTRL|SHIFT', action = act.ActivateTab(0) },
  { key = '2', mods = 'CTRL|SHIFT', action = act.ActivateTab(1) },
  { key = '3', mods = 'CTRL|SHIFT', action = act.ActivateTab(2) },
  { key = '4', mods = 'CTRL|SHIFT', action = act.ActivateTab(3) },
  { key = '5', mods = 'CTRL|SHIFT', action = act.ActivateTab(4) },
  { key = '6', mods = 'CTRL|SHIFT', action = act.ActivateTab(5) },
  { key = '7', mods = 'CTRL|SHIFT', action = act.ActivateTab(6) },
  { key = '8', mods = 'CTRL|SHIFT', action = act.ActivateTab(7) },
  { key = '9', mods = 'CTRL|SHIFT', action = act.ActivateTab(-1) },
  { key = '1', mods = 'SUPER', action = act.ActivateTab(0) },
  { key = '2', mods = 'SUPER', action = act.ActivateTab(1) },
  { key = '3', mods = 'SUPER', action = act.ActivateTab(2) },
  { key = '4', mods = 'SUPER', action = act.ActivateTab(3) },
  { key = '5', mods = 'SUPER', action = act.ActivateTab(4) },
  { key = '6', mods = 'SUPER', action = act.ActivateTab(5) },
  { key = '7', mods = 'SUPER', action = act.ActivateTab(6) },
  { key = '8', mods = 'SUPER', action = act.ActivateTab(7) },
  { key = '9', mods = 'SUPER', action = act.ActivateTab(-1) },
  { key = 'Tab',      mods = 'CTRL',       action = act.ActivateTabRelative(1) },
  { key = 'Tab',      mods = 'CTRL|SHIFT', action = act.ActivateTabRelative(-1) },
  { key = 'PageUp',   mods = 'CTRL',       action = act.ActivateTabRelative(-1) },
  { key = 'PageDown', mods = 'CTRL',       action = act.ActivateTabRelative(1) },

  -- デバッグ・設定（Ctrl+L → Ctrl+Shift+L に変更してzshのCtrl+Lを解放）
  { key = 'L', mods = 'CTRL|SHIFT', action = act.ShowDebugOverlay },
  { key = 'R', mods = 'CTRL|SHIFT', action = act.ReloadConfiguration },
  { key = 'P', mods = 'CTRL|SHIFT', action = act.ActivateCommandPalette },
  { key = 'K', mods = 'CTRL|SHIFT', action = act.ClearScrollback 'ScrollbackOnly' },

  -- Shift+Enterで改行を送信（Claude Code用）
  { key = 'Enter', mods = 'SHIFT', action = act.SendString('\n') },

{{- if eq .chezmoi.os "windows" }}
  -- WSL HOMEで新しいタブを開く（Windows専用: DefaultDomainだとWindows側HOMEになるため明示指定）
  { key = 'T', mods = 'CTRL|SHIFT', action = act.SpawnCommandInNewTab {
    args = { '/bin/zsh', '-lc', 'cd && exec /bin/zsh -l' },
    domain = { DomainName = 'WSL:' .. distro },
  }},
  -- PowerShellを新しいタブで開く（Windows専用）
  { key = 'W', mods = 'CTRL|SHIFT', action = act.SpawnCommandInNewTab {
    args = { 'pwsh.exe' },
    domain = { DomainName = 'local' },
  }},
{{- else }}
  -- 新しいタブを開く（デフォルトドメイン）
  { key = 'T', mods = 'CTRL|SHIFT', action = act.SpawnTab 'DefaultDomain' },
{{- end }}
}

-- 通知
local function is_claude(pane)
  local process = pane:get_foreground_process_info()
  if not process or not process.argv then
    return false
  end
  -- 引数に"claude"が含まれているかチェック
  for _, arg in ipairs(process.argv) do
    if arg:find("claude") then
      return true
    end
  end
  return false
end

wezterm.on("bell", function(window, pane)
  if is_claude(pane) then
    window:toast_notification("Claude Code", "Task completed", nil, 4000)
  end
end)

-- Startup
{{- if eq .chezmoi.os "darwin" }}
local zellij = "/opt/homebrew/bin/zellij"
{{- else }}
local zellij = "/home/linuxbrew/.linuxbrew/bin/zellij"
{{- end }}
wezterm.on('gui-startup', function(cmd)
  -- Zellij session一覧取得
  local success, stdout, stderr = wezterm.run_child_process({
{{- if eq .chezmoi.os "windows" }}
    "wsl.exe",
    "-d",
    distro,
    "--",
{{- end }}
    "/bin/zsh",
    "-lc",
    zellij .. " list-sessions --no-formatting --short",
  })
  local sessions = {}
  if success and stdout then
    for line in stdout:gmatch("[^\r\n]+") do
      local s = line:match("^%s*(.-)%s*$")
      if s ~= "" then
        table.insert(sessions, s)
      end
    end
    wezterm.log_info("successed to get zellij sessions: " .. stdout)
  else
    wezterm.log_error("failed to get zellij sessions: " .. stderr)
  end

  local tab, pane, window
  if #sessions > 0 then
    tab, pane, window = wezterm.mux.spawn_window({
      args = {
        "zsh",
        "-lc",
        'exec ' .. zellij .. ' attach ' .. sessions[1],
      },
    })

    for i = 2, #sessions do
      window:spawn_tab({
        args = {
          "zsh",
          "-lc",
          'exec ' .. zellij .. ' attach ' .. sessions[i],
        },
      })
    end
  end

  window:gui_window():maximize()
end)

return config
