[bootstrap.packages]
{{- if lookPath "apt" }}
"apt:build-essential" = "latest"
"apt:zsh-autosuggestions" = "latest"
"apt:zsh-syntax-highlighting" = "latest"
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
"brew:gcc" = "latest"
"brew:zsh-autosuggestions" = "latest"
"brew:zsh-syntax-highlighting" = "latest"
"brew-cask:claude" = "latest"
"brew-cask:codex-app" = "latest"
"brew-cask:codexbar" = "latest"
"brew-cask:firefox" = "latest"
"brew-cask:font-hackgen-nerd" = "latest"
"brew-cask:font-moralerspace" = "latest"
"brew-cask:font-udev-gothic-nf" = "latest"
"brew-cask:ghostty" = "latest"
"brew-cask:karabiner-elements" = "latest"
"brew-cask:lm-studio" = "latest"
"brew-cask:obsidian" = "latest"
# raycast: mise の brew-cask が拡張子なし URL の DMG を展開できず
# "app artifact 'Raycast.app' was not found" で失敗するため除外。
# Raycast は自己更新型 (auto_updates) なので手動インストールで運用。
# "brew-cask:raycast" = "latest"
"brew-cask:rectangle" = "latest"
"brew-cask:scroll-reverser" = "latest"
"brew-cask:visual-studio-code" = "latest"
"brew-cask:zed" = "latest"
"brew-cask:zen" = "latest"
{{- if .isWork }}
"brew:git-secret" = "latest"
"brew:gnupg" = "latest"
{{- end }}
{{- end }}

[settings]
disable_backends = ["asdf", "ubi", "vfox"]

[tools]
bat = "latest"
bottom = "latest"
bun = "latest"
chezmoi = "latest"
direnv = "latest"
eza = "latest"
fd = "latest"
fzf = "latest"
gh = "latest"
ghq = "latest"
herdr = "latest"
jq = "latest"
lazygit = "latest"
neovim = "latest"
node = "lts"
ripgrep = "latest"
rtk = "latest"
starship = "latest"
uv = "latest"
yazi = "latest"
yq = "latest"
zoxide = "latest"

{{- if eq .chezmoi.os "darwin" }}
colima = "latest"
{{- end }}

{{- if .isWork }}
aws-cli = "latest"
azure-cli = "latest"
claude-code = "latest"
codex = "latest"
copilot-cli = "latest"
crane = "latest"
docker-cli = "latest"
docker-compose = "latest"
# gcloud = "latest"  # only hosted on asdf or vfox
terraform = "1.9.7"
"aqua:DataDog/pup" = "latest"
"aqua:docker/buildx" = "latest"
{{- else }}
opencode = "latest"
{{- end }}
