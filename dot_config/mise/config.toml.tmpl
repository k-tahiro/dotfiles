[bootstrap.packages]
{{- if lookPath "apt" }}
"apt:build-essential" = "latest"
"apt:zsh-autosuggestions" = "latest"
"apt:zsh-syntax-highlighting" = "latest"
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
"brew:gcc" = "latest"
"brew:zsh-autosuggestions" = "latest"
"brew:zsh-syntax-highlighting" = "latest"
"brew-cask:claude" = "latest"
"brew-cask:codex-app" = "latest"
"brew-cask:codexbar" = "latest"
"brew-cask:firefox" = "latest"
"brew-cask:font-hackgen-nerd" = "latest"
"brew-cask:font-moralerspace" = "latest"
"brew-cask:font-udev-gothic-nf" = "latest"
"brew-cask:ghostty" = "latest"
"brew-cask:karabiner-elements" = "latest"
"brew-cask:lm-studio" = "latest"
"brew-cask:obsidian" = "latest"
"brew-cask:raycast" = "latest"
"brew-cask:rectangle" = "latest"
"brew-cask:scroll-reverser" = "latest"
"brew-cask:visual-studio-code" = "latest"
"brew-cask:zed" = "latest"
{{- if .isWork }}
"brew:git-secret" = "latest"
"brew:gnupg" = "latest"
{{- end }}
{{- end }}

{{- if .isWork }}
# Workaround for https://github.com/jdx/mise/issues/15034
[plugins]
gcloud = "https://github.com/jdx/vfox-gcloud"
{{- end }}

[settings]
{{- if .isWork }}
disable_backends = []
{{- else }}
disable_backends = ["asdf", "ubi", "vfox"]
{{- end }}

[tools]
apm = "latest"
bat = "latest"
bottom = "latest"
chezmoi = "latest"
claude-code = "latest"
codex = "latest"
direnv = "latest"
eza = "latest"
fd = "latest"
fzf = "latest"
gh = "latest"
ghq = "latest"
herdr = "latest"
jq = "latest"
lazygit = "latest"
marp-cli = "latest"
neovim = "latest"
node = "lts"
ripgrep = "latest"
rtk = "latest"
starship = "latest"
uv = "latest"
yazi = "latest"
yq = "latest"
zoxide = "latest"

{{- if eq .chezmoi.os "darwin" }}
colima = "latest"
lima = "latest"
{{- end }}

{{- if .isWork }}
# Docker
crane = "latest"
docker-cli = "latest"
docker-compose = "latest"
"aqua:docker/buildx" = "latest"

# Cloud
aws-cli = "latest"
azure-cli = "latest"
gcloud = "latest"  # only hosted on asdf or vfox
terraform = "latest"
"aqua:DataDog/pup" = "latest"

# Others
"npm:@helpfeel/cosense-cli" = "latest"
{{- else }}
# OpenCode
opencode = "latest"
bun = "latest"

# Pi
pi = "latest"

# DeepSeek Harness
"npm:@deepseek-ai/dsh" = { version = "latest", prerelease = true }
pnpm = "latest"

# Others
"npm:zenn-cli" = "latest"
{{- end }}
