[settings]
disable_backends = ["asdf", "vfox"]

[tools]
node = "lts"
uv = "latest"

# --- Homebrewから移行したCLIツール ---
bat = "latest"
bottom = "latest"
direnv = "latest"
eza = "latest"
fd = "latest"
fzf = "latest"
gh = "latest"
ghq = "latest"
jq = "latest"
lazygit = "latest"
# neovimはaquaバックエンドを明示（デフォルトのvfoxはGitHub API依存が強くレート制限で失敗しやすいため）
"aqua:neovim/neovim" = "latest"
ripgrep = "latest"
starship = "latest"
yazi = "latest"
yq = "latest"
zoxide = "latest"
bun = "latest"
"npm:ccusage" = "latest"
# rtk(Rust Token Killer)/herdr(端末マルチプレクサ)もaquaバックエンドを明示
"aqua:rtk-ai/rtk" = "latest"
"aqua:ogulcancelik/herdr" = "latest"

{{- if .isWork }}
aws-cli = "latest"
crane = "latest"
terraform = "1.9.7"
{{- else }}
opencode = "latest"
{{- end }}
