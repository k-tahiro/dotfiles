{{- /* chezmoi:modify-template */ -}}

{{- $env := dict -}}
{{- $env = setValueAtPath "ANTHROPIC_DEFAULT_MODEL" "opusplan" $env -}}
{{- $env = setValueAtPath "ANTHROPIC_DEFAULT_OPUS_MODEL" "claude-fable-5[1m]" $env -}}
{{- $env = setValueAtPath "ANTHROPIC_DEFAULT_SONNET_MODEL" "claude-sonnet-5[1m]" $env -}}

{{- $permissions := dict -}}
{{- $permissions = setValueAtPath "defaultMode" "plan" $permissions -}}
{{- $permissions = setValueAtPath "disableBypassPermissionsMode" "disable" $permissions -}}
{{- $allow := list -}}
{{- $allow = append $allow "Read" -}}
{{- $permissions = setValueAtPath "allow" $allow $permissions -}}
{{- $deny := list -}}
{{- $deny = append $deny "Bash(sudo *)" -}}
{{- $deny = append $deny "Bash(rm -rf *)" -}}
{{- $deny = append $deny "Read(**/.env*)" -}}
{{- $deny = append $deny "Read(id_rsa)" -}}
{{- $deny = append $deny "Read(id_ed25519)" -}}
{{- $deny = append $deny "Write(**/.env*)" -}}
{{- $permissions = setValueAtPath "deny" $deny $permissions -}}

{{- $settings := fromJson (default "{}" .chezmoi.stdin) -}}
{{- $settings = setValueAtPath "env" (mergeOverwrite $settings.env $env) $settings -}}
{{- $settings = setValueAtPath "permissions" (mergeOverwrite $settings.permissions $permissions) $settings -}}
{{- $settings | toPrettyJson -}}
