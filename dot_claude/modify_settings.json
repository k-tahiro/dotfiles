{{- /* chezmoi:modify-template */ -}}
{{- $existing := fromJson (default "{}" .chezmoi.stdin) -}}
{{- $result := setValueAtPath "permissions" .claude.settings.permissions $existing -}}
{{- $existingHooks := dict -}}
{{- if hasKey $existing "hooks" -}}{{- $existingHooks = index $existing "hooks" -}}{{- end -}}
{{- range $event, $dataEntries := .claude.settings.hooks -}}
  {{- $merged := list -}}
  {{- if hasKey $existingHooks $event -}}{{- $merged = index $existingHooks $event -}}{{- end -}}
  {{- $seen := list -}}
  {{- range $merged -}}{{- $seen = append $seen (toJson .) -}}{{- end -}}
  {{- range $dataEntries -}}
    {{- if not (has (toJson .) $seen) -}}{{- $merged = append $merged . -}}{{- end -}}
  {{- end -}}
  {{- $result = setValueAtPath (list "hooks" $event) $merged $result -}}
{{- end -}}
{{- $existingEnv := dict -}}
{{- if hasKey $existing "env" -}}{{- $existingEnv = index $existing "env" -}}{{- end -}}
{{- range $k, $v := .claude.settings.env -}}
  {{- $existingEnv = setValueAtPath $k $v $existingEnv -}}
{{- end -}}
{{- $result = setValueAtPath "env" $existingEnv $result -}}
{{ $result | toPrettyJson }}
