#!/bin/bash
set -euo pipefail

# ハッシュ値が変わった（＝中身が書き換わった）時だけ実行されます
# {{ include ".chezmoidata/claude.json" | sha256sum }}

if ! command -v claude &> /dev/null; then
    echo "Error: Claude Code is not installed. Please install Claude Code first."
    exit 1
fi

FILE="$HOME/.claude/settings.json"
TMP="$(mktemp)"

if [ ! -f "$FILE" ]; then
  echo '{}' > "$FILE"
fi

echo "Merginging for Claude Code settings..."
COMMON='{{ .claude.settings | toJson }}'

jq --argjson common "$COMMON" '
  . * $common
' "$FILE" > "$TMP"

mv "$TMP" "$FILE"
cat "$FILE"
