#!/bin/bash
set -euo pipefail

# ハッシュ値が変わった（＝中身が書き換わった）時だけ実行されます
# {{ include ".chezmoidata/mcp.toml" | sha256sum }}

if ! command -v claude &> /dev/null; then
    echo "Error: Claude Code is not installed. Please install Claude Code first."
    exit 1
fi

FILE="$HOME/.claude.json"
TMP="$(mktemp)"

if [ ! -f "$FILE" ]; then
  echo '{}' > "$FILE"
fi

echo "Merging MCP servers into Claude Code config..."
MCP_SERVERS='{{ .mcpServers | toJson }}'

jq --argjson mcp "$MCP_SERVERS" '
  .mcpServers = ((.mcpServers // {}) * $mcp)
' "$FILE" > "$TMP"

mv "$TMP" "$FILE"
echo "Done."
