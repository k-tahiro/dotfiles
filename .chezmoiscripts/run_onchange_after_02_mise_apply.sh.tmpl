#!/bin/bash
set -euo pipefail

# miseのconfig.toml のハッシュ値が変わった（＝中身が書き換わった）時だけ実行されます
# {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

if ! command -v mise &> /dev/null; then
    echo "Error: mise is not installed. Please install mise first."
    exit 1
fi

# bootstrap は sudo (apt/brew 等のシステムパッケージ) を必要とする。
# sudo が無い / 非対話で使えない環境ではスキップし、ユーザ権限の install/prune は継続する。
if [ "$(id -u)" -eq 0 ] || { command -v sudo >/dev/null && sudo -n true 2>/dev/null; }; then
    mise bootstrap -y
    mise bootstrap packages prune -y
else
    echo "sudo is not available non-interactively. Skipping mise bootstrap (system packages)."
fi

mise install -y
mise prune -y
