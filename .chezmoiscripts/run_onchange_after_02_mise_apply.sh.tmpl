#!/bin/bash
set -euo pipefail

# miseのconfig.toml のハッシュ値が変わった（＝中身が書き換わった）時だけ実行されます
# {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

if ! command -v mise &> /dev/null; then
    echo "Error: mise is not installed. Please install mise first."
    exit 1
fi

# bootstrap は sudo (apt 等のシステムパッケージ) を必要とすることがある。
# 失敗しても apply 全体を止めず、ユーザ権限の install/prune は継続する。
if ! mise bootstrap -y; then
    echo "Warning: mise bootstrap failed (sudo unavailable?). Skipping system packages." >&2
fi
if ! mise bootstrap packages prune -y; then
    echo "Warning: mise bootstrap packages prune failed. Skipping." >&2
fi

mise install -y
mise prune -y
