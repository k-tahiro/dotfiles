#!/bin/bash
set -euo pipefail

# miseのconfig.toml のハッシュ値が変わった（＝中身が書き換わった）時だけ実行されます
# {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

BREW={{ .brewBin | quote }}

if [[ ! -x "$BREW" ]]; then
    echo "Error: Homebrew not found at $BREW"
    exit 1
fi

eval "$("$BREW" shellenv)"

if ! command -v mise &> /dev/null; then
    echo "Error: mise is not installed. Please install mise first."
    exit 1
fi

# GitHub APIレート制限(未認証60回/時)対策: gh認証済みならトークンを渡して5000回/時に上げる。
# gh自体もmise管理のため、初回はまだ無い場合がある（その場合はスキップ）。
export PATH="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims:$PATH"
if [[ -z "${GITHUB_TOKEN:-}" ]] && command -v gh &> /dev/null; then
    GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"
    [[ -n "$GITHUB_TOKEN" ]] && export GITHUB_TOKEN
fi

mise install
mise prune -y
