#!/bin/bash
set -euo pipefail

# herdr 未導入なら何もしない
command -v herdr >/dev/null 2>&1 || exit 0

status="$(herdr status --json 2>/dev/null || true)"
[[ -z "$status" ]] && exit 0

# サーバー未起動なら何もしない
running="$(printf '%s' "$status" | jq -r '.server.running // false')"
[[ "$running" == "true" ]] || exit 0

# バイナリより古いサーバーが動いている場合のみ警告（自動再起動はしない）
if [[ "$(printf '%s' "$status" | jq -r '.server.restart_needed // false')" == "true" ]]; then
    cver="$(printf '%s' "$status" | jq -r '.client.version')"
    sver="$(printf '%s' "$status" | jq -r '.server.version')"
    echo "⚠️  herdr サーバー($sver)がバイナリ($cver)より古く、再起動が必要です。"
    echo "    → 'herdr update --handoff' を試すか、'herdr server stop' 後に 'herdr' で再起動してください。"
fi
