#!/bin/bash
set -euo pipefail

# Brewfile のハッシュ値が変わった（＝中身が書き換わった）時だけ実行されます
# {{ include ".chezmoidata/homebrew.toml" | sha256sum }}
# {{ include "dot_config/homebrew/Brewfile.tmpl" | sha256sum }}

{{ if eq .chezmoi.os "linux" -}}
BREW="/home/linuxbrew/.linuxbrew/bin/brew"
{{ else if eq .chezmoi.arch "arm64" -}}
BREW="/opt/homebrew/bin/brew"
{{ else -}}
BREW="/usr/local/bin/brew"
{{ end -}}

if [[ ! -x "$BREW" ]]; then
    echo "Error: Homebrew not found at $BREW"
    exit 1
fi

eval "$("$BREW" shellenv)"

echo "Checking for new Homebrew packages..."
"$BREW" bundle --cleanup --global
