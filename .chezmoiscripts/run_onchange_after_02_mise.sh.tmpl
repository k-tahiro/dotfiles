#!/bin/bash
set -euo pipefail

# miseのconfig.toml のハッシュ値が変わった（＝中身が書き換わった）時だけ実行されます
# {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

{{ if eq .chezmoi.os "linux" -}}
BREW="/home/linuxbrew/.linuxbrew/bin/brew"
{{ else if eq .chezmoi.arch "arm64" -}}
BREW="/opt/homebrew/bin/brew"
{{ else -}}
BREW="/usr/local/bin/brew"
{{ end -}}

if [[ ! -x "$BREW" ]]; then
    echo "Error: Homebrew not found at $BREW"
    exit 1
fi

eval "$("$BREW" shellenv)"

if ! command -v mise &> /dev/null; then
    echo "Error: mise is not installed. Please install mise first."
    exit 1
fi

echo "Checking for new mise packages..."
mise install
