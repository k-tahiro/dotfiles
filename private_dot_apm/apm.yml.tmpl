name: k-tahiro
version: 1.0.0
description: APM project for k-tahiro
author: k-tahiro
targets:
{{- if lookPath "claude"}}
  - claude
{{- end }}
{{- if lookPath "codex"}}
  - codex
{{- end }}
{{- if lookPath "opencode"}}
  - opencode
{{- end }}

dependencies:
  apm:
    - iKora128/stop-ai-slop-jp
  mcp:
    - name: github
      registry: false
      transport: stdio
      command: github-mcp-server-stdio
    - name: serena
      registry: false
      transport: stdio
      command: serena
      args: ["start-mcp-server", "--project-from-cwd"]
includes: auto
scripts: {}
